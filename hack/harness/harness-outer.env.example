# hack/harness/harness-outer.env.example: the OUTER-target identity the harness
# reads (the roster target, its node/FQDN, the pool, the tag, the storage and
# the VMID band). Copy it to ~/.config/pveforge/harness-outer.env (mode 0600)
# and fill it in for the hypervisor this workstation is targeting.
#
# It is READ by read_outer_identity in hack/harness/lib.sh, never sourced: each
# line is blank, a # comment, or KEY=value with no quotes and no expansion.
# Every key below is required, an unknown or repeated key is refused, and each
# value must match its key's strict pattern, so a value can be placed in a PVE
# parameter, a roster id or an ACL path without escaping. The values are made
# readonly the instant they validate, before any network call, and are never
# taken from the environment (operator ruling 2026-09-24 (3), relaxed to this
# site file at the operator's request).
#
# This is SEPARATE from harness-build.env (hb_read_env / HB_PATTERN): the build
# site file carries the per-VM network/IP/MAC/sizes; this one carries only the
# outer-target identity. Keep them disjoint — do not move keys between them.
#
# N hypervisors coexist on one workstation because the roster and the D5 P0
# baseline are host-keyed from OUTER_NODE: harness-<node>-outer.toml and
# harness-<node>-outer.p0. Point this file at a different host and its files are
# a different pair; there is no un-keyed fallback.

# OUTER_NODE: the PVE node short name (a single host/path segment, <=63 chars;
# no '.', no space, no leading hyphen).
OUTER_NODE=qa-pve-07
# OUTER_FQDN: the node's fully qualified name; must begin with OUTER_NODE. so
# it names this same host (used for the D5 root ssh and host-key pin).
OUTER_FQDN=qa-pve-07.lab.quantum.com
# OUTER_TARGET: the harness roster id (an API argument, not a path; no '.').
OUTER_TARGET=qa-pve-07-harness
# OUTER_POOL: the harness poolid (no '.': it is interpolated into the D5
# ownership regex).
OUTER_POOL=pveforge-harness
# OUTER_TAG: the tag every harness VM carries (lowercase; already excludes '.').
OUTER_TAG=pveforge-harness
# OUTER_STORAGE: the outer storage id (the probe/build/reset --storage default
# and D5_STORAGE; a PVE storage id, interpolated into the D5 ownership regex).
OUTER_STORAGE=pveforge-harness
# VMID_LOW / VMID_HIGH: the harness VMID band — decade-aligned, exactly ten
# ids. VMID_LOW must end in 0 and VMID_HIGH must be VMID_LOW + 9. The three
# nested guests (pvh-n1, pvh-n2, pvh-nfs) are VMID_LOW, +1, +2.
VMID_LOW=690
VMID_HIGH=699

.nh
.TH "PVEFORGE" "1" "Sep 2026" "pveforge" "pveforge manual"

.SH NAME
pveforge-discover-storage - Describe a storage backend's config or status schema, per PVE's own API-doc tree


.SH SYNOPSIS
\fBpveforge discover storage <target-id> [flags]\fP


.SH DESCRIPTION
Describe a storage backend's config or status schema, per PVE's own API-doc tree


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for storage

.PP
\fB-o\fP, \fB--output\fP="kv"
	output format: "kv" or "json"

.PP
\fB--roster\fP=""
	path to the roster file (overrides PVEFORGE_ROSTER and the default ./pveforge.toml)

.PP
\fB--verb\fP="config"
	which storage sub-resource to describe: "config" (cluster-wide definition, default) or "status" (per-node runtime status)


.SH SEE ALSO
\fBpveforge-discover(1)\fP

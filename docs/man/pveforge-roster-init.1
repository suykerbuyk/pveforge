.nh
.TH "PVEFORGE" "1" "Sep 2026" "pveforge" "pveforge manual"

.SH NAME
pveforge-roster-init - Create a new, empty roster file


.SH SYNOPSIS
\fBpveforge roster init [path] [flags]\fP


.SH DESCRIPTION
Create a new, empty roster file


.SH OPTIONS
\fB--force\fP[=false]
	overwrite an existing roster file

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for init


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--roster\fP=""
	path to the roster file (overrides PVEFORGE_ROSTER and the default ./pveforge.toml)


.SH SEE ALSO
\fBpveforge-roster(1)\fP
